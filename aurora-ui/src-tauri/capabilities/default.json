{
  "$schema": "../gen/schemas/desktop-capability.json",
  "identifier": "default",
  "description": "Default permissions for Aurora",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "fs:default",
    "dialog:default",
    "log:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "args": true,
          "name": "binaries/MegaDriveEmu",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "fs:allow-read",
      "allow": ["$APP_DATA/**/*", "$RESOURCE/**/*"]
    },
    {
      "identifier": "fs:allow-write",
      "allow": ["$APP_DATA/**/*"]
    }
  ]
}
